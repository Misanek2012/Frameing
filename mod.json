{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081"
    },
    "id": "fwlab.frame-window-lab",
    "name": "Frame Window Lab",
    "version": "v0.2.0",
    "developer": "FrameWindowLab",
    "description": "NaN-style frame window counter: frame-exact recording, frame stepping, input shifting, measured frame windows, hitboxes, player path and circle indicators.",
    "resources": {
        "files": [
            "resources/sounds/*.mp3"
        ]
    },
    "settings": {
        "title-general": {
            "type": "title",
            "name": "General"
        },
        "show-overlay": {
            "type": "bool",
            "name": "Show overlay on level start",
            "default": true
        },
        "esc-pauses": {
            "type": "bool",
            "name": "Esc freezes the game (timeline stays usable)",
            "description": "Shift+Esc or GD's on-screen pause button open GD's pause menu.",
            "default": true
        },
        "lock-ticks-recording": {
            "type": "bool",
            "name": "Lock 1 physics tick per update while recording",
            "description": "Runs exactly one physics tick per update call (real-time speed, FPS-independent). Required for replays to reproduce recordings reliably.",
            "default": true
        },
        "replay-budget-ms": {
            "type": "int",
            "name": "Replay speed (ms of simulation per frame)",
            "description": "Fast replays (seeking, analysis) simulate physics for this many milliseconds per rendered frame. Higher = faster analysis, lower = smoother UI.",
            "default": 12,
            "min": 2,
            "max": 60,
            "control": {
                "slider": true,
                "arrows": true
            }
        },
        "resim-on-edit": {
            "type": "bool",
            "name": "Re-simulate after edits while paused",
            "description": "After moving, adding or deleting an input while paused, replay to the current frame so the path and player show the edited inputs.",
            "default": true
        },
        "showcase-speed": {
            "type": "float",
            "name": "Showcase speed (S)",
            "description": "Replay speed in showcase mode (S).",
            "default": 0.5,
            "min": 0.01,
            "max": 1,
            "control": {
                "slider": true,
                "slider-step": 0.01
            }
        },
        "window-dings": {
            "type": "bool",
            "name": "Ding for each click with a marked window during replays",
            "default": true,
            "description": "The ding number is the window size: 1-frame window = ding 1 ... 6 or more frames = ding 6, like NaN's showcases."
        },
        "sweep-radius": {
            "type": "int",
            "name": "Sweep initial radius (ticks)",
            "default": 6,
            "min": 1,
            "max": 240
        },
        "sweep-max-radius": {
            "type": "int",
            "name": "Sweep maximum radius (ticks)",
            "default": 240,
            "min": 1,
            "max": 2400
        },
        "goal-default-ticks": {
            "type": "int",
            "name": "Default goal: ticks after selected input",
            "description": "Used when no goal marker is set (G on the timeline).",
            "default": 240,
            "min": 1,
            "max": 24000
        },
        "title-timeline": {
            "type": "title",
            "name": "Timeline"
        },
        "timeline-height": {
            "type": "float",
            "name": "Timeline height",
            "default": 56,
            "min": 24,
            "max": 160,
            "control": {
                "slider": true
            }
        },
        "timeline-opacity": {
            "type": "float",
            "name": "Timeline background opacity",
            "default": 0.45,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true,
                "slider-step": 0.05
            }
        },
        "timeline-zoom": {
            "type": "float",
            "name": "Default zoom (points per frame)",
            "default": 0.65,
            "min": 0.05,
            "max": 8
        },
        "color-press": {
            "type": "rgba",
            "name": "Press marker",
            "default": [
                90,
                220,
                100,
                255
            ]
        },
        "color-release": {
            "type": "rgba",
            "name": "Release marker",
            "default": [
                235,
                90,
                90,
                255
            ]
        },
        "color-pass": {
            "type": "rgba",
            "name": "Passing tick",
            "default": [
                60,
                255,
                110,
                150
            ]
        },
        "color-fail": {
            "type": "rgba",
            "name": "Failing tick",
            "default": [
                255,
                60,
                70,
                120
            ]
        },
        "color-goal": {
            "type": "rgba",
            "name": "Goal marker",
            "default": [
                80,
                200,
                255,
                255
            ]
        },
        "color-path": {
            "type": "rgba",
            "name": "Player path",
            "default": [
                255,
                225,
                40,
                235
            ]
        },
        "color-current-frame": {
            "type": "rgba",
            "name": "Current frame bar",
            "default": [
                0,
                230,
                255,
                255
            ]
        },
        "title-hitboxes": {
            "type": "title",
            "name": "Hitboxes"
        },
        "hitboxes": {
            "type": "bool",
            "name": "Show hitboxes",
            "default": true
        },
        "hb-player": {
            "type": "bool",
            "name": "Player",
            "default": true
        },
        "hb-hazard": {
            "type": "bool",
            "name": "Hazards (spikes, saws)",
            "default": true
        },
        "hb-solid": {
            "type": "bool",
            "name": "Solids",
            "default": true
        },
        "hb-special": {
            "type": "bool",
            "name": "Orbs, pads, portals, triggers",
            "default": true
        },
        "hb-other": {
            "type": "bool",
            "name": "Unclassified",
            "default": true
        },
        "hb-color-player": {
            "type": "rgba",
            "name": "Player colour",
            "default": [
                255,
                255,
                0,
                255
            ]
        },
        "hb-color-hazard": {
            "type": "rgba",
            "name": "Hazard colour",
            "default": [
                255,
                40,
                40,
                255
            ]
        },
        "hb-color-solid": {
            "type": "rgba",
            "name": "Solid colour",
            "default": [
                40,
                120,
                255,
                255
            ]
        },
        "hb-color-special": {
            "type": "rgba",
            "name": "Special colour",
            "default": [
                40,
                255,
                120,
                255
            ]
        },
        "hb-color-other": {
            "type": "rgba",
            "name": "Unclassified colour",
            "default": [
                255,
                255,
                255,
                200
            ]
        },
        "hb-thickness": {
            "type": "float",
            "name": "Outline thickness",
            "default": 0.5,
            "min": 0.1,
            "max": 4,
            "control": {
                "slider": true,
                "slider-step": 0.1
            }
        },
        "hb-fill-opacity": {
            "type": "float",
            "name": "Fill opacity",
            "default": 0.28,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true,
                "slider-step": 0.02
            }
        },
        "title-circles": {
            "type": "title",
            "name": "Circles"
        },
        "show-path": {
            "type": "bool",
            "name": "Show the player path",
            "default": true
        },
        "show-indicators": {
            "type": "bool",
            "name": "Show circles (window size at each click)",
            "default": true
        },
        "show-tally": {
            "type": "bool",
            "name": "Show the window tally (top left)",
            "description": "Counts how many clicks of each window size have passed, like NaN's counter.",
            "default": true
        },
        "indicator-radius": {
            "type": "float",
            "name": "Circle size",
            "default": 14,
            "min": 3,
            "max": 30,
            "control": {
                "slider": true
            }
        },
        "circle-color-1": {
            "type": "rgba",
            "name": "Circle colour: 1-frame window",
            "default": [
                255,
                80,
                80,
                255
            ]
        },
        "circle-color-2": {
            "type": "rgba",
            "name": "Circle colour: 2-frame window",
            "default": [
                240,
                165,
                240,
                255
            ]
        },
        "circle-color-3": {
            "type": "rgba",
            "name": "Circle colour: 3-frame window",
            "default": [
                255,
                205,
                60,
                255
            ]
        },
        "circle-color-4": {
            "type": "rgba",
            "name": "Circle colour: 4-frame window",
            "default": [
                255,
                255,
                255,
                255
            ]
        },
        "circle-color-5": {
            "type": "rgba",
            "name": "Circle colour: 5-frame window",
            "default": [
                60,
                235,
                60,
                255
            ]
        },
        "circle-color-6": {
            "type": "rgba",
            "name": "Circle colour: 6+-frame window",
            "default": [
                80,
                220,
                255,
                255
            ]
        },
        "circle-radius": {
            "type": "float",
            "name": "New circle radius",
            "default": 14,
            "min": 2,
            "max": 200
        },
        "circle-thickness": {
            "type": "float",
            "name": "New circle outline",
            "default": 2,
            "min": 0.5,
            "max": 12
        },
        "circle-fill": {
            "type": "float",
            "name": "New circle fill opacity",
            "default": 0.15,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true,
                "slider-step": 0.05
            }
        },
        "circle-color": {
            "type": "rgba",
            "name": "New circle colour",
            "default": [
                255,
                200,
                40,
                255
            ]
        },
        "title-sound": {
            "type": "title",
            "name": "Sound"
        },
        "sound-enabled": {
            "type": "bool",
            "name": "Enable sounds",
            "default": true
        },
        "sound-volume": {
            "type": "float",
            "name": "Volume",
            "default": 0.6,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true,
                "slider-step": 0.05
            }
        },
        "sound-count": {
            "type": "bool",
            "name": "Rising count dings during sweeps",
            "description": "Each passing tick of a sweep plays the next higher ding (1-6).",
            "default": true
        },
        "sound-step": {
            "type": "int",
            "name": "Ding for tick step (0 = off)",
            "default": 0,
            "min": 0,
            "max": 6
        },
        "sound-select": {
            "type": "int",
            "name": "Ding for selecting input",
            "default": 2,
            "min": 0,
            "max": 6
        },
        "sound-move": {
            "type": "int",
            "name": "Ding for moving input",
            "default": 1,
            "min": 0,
            "max": 6
        },
        "sound-circle": {
            "type": "int",
            "name": "Ding for creating circle",
            "default": 3,
            "min": 0,
            "max": 6
        },
        "sound-pass": {
            "type": "int",
            "name": "Ding for passing test",
            "default": 6,
            "min": 0,
            "max": 6
        },
        "sound-fail": {
            "type": "int",
            "name": "Ding for failing test",
            "default": 1,
            "min": 0,
            "max": 6
        },
        "sound-done": {
            "type": "int",
            "name": "Ding for sweep finished",
            "default": 5,
            "min": 0,
            "max": 6
        },
        "timing-log": {
            "type": "bool",
            "name": "Log physics timing (diagnostics)",
            "description": "Writes physics step counts to the Geode log every 2 seconds.",
            "default": true
        }
    }
}