# Single source of truth for what this mod is built and verified against.
# GD 2.2081 is the previous release (2.209 shipped 2026-10-15). Geode v5.11.2
# is the latest SDK and is still primarily for 2.2081. bindings@main also
# tracks 2.209+, so it is pinned to the commit this mod was verified with.
GD_VERSION=2.2081
GEODE_REF=v5.11.2
BINDINGS_REF=8a2f67600a8291acf68698182b9c045467aff5e1
# Header-only deps at the exact refs Geode v5.11.2's CMakeLists requests.
RESULT_REF=v1.4.1
JSON_REF=v3.3.1
NTF_REF=6d1d08c
FMT_REF=5ac44cd
ASP_REF=ecea33b
ARC_REF=v1.5.11
TULIP_REF=v3.1.15
